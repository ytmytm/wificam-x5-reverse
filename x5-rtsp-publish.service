[Unit]
Description=Publish TXW817 X5 video and audio as RTSP
After=x5-mediamtx.service
Wants=x5-mediamtx.service
Before=home-assistant@homeassistant.service

[Service]
Type=simple
User=pi
Group=pi
EnvironmentFile=-/etc/x5-viewer.env
ExecStart=/usr/bin/python3 /opt/x5-viewer/x5_rtsp_publish.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
