# Copy to a protected local file and fill in X5_API_TOKEN.
X5_UID=276642521291
X5_CAMERA_IP=192.168.2.158
X5_API_TOKEN=replace-with-a-local-token
X5_APP_ID=863b979a7c9dedd5c85b3626b02c9bfe9c771583
X5_LISTEN_PORT=50001
X5_HTTP_PORT=5080

# Optional overrides:
# X5_API_BASE=http://ipc.gps555.net
# X5_LISTEN_HOST=0.0.0.0
# Keep the demo UI local; HA and the RTSP publisher use localhost.
X5_HTTP_HOST=127.0.0.1

# Diagnostic logging (tokens and packet payloads are never logged).
# X5_LOG_LEVEL=INFO
# X5_LOG_INTERVAL=10
# X5_VIDEO_STALE_SECONDS=30
# X5_VIDEO_GRACE_SECONDS=30
# Keep FFmpeg's pipe queues tiny: stale camera data must be dropped, not replayed.
# X5_FFMPEG_INPUT_QUEUE=1
# Control-only HTTP is bound to localhost for Home Assistant; the web viewer
# remains disabled in the RTSP deployment.
# X5_CONTROL_HOST=127.0.0.1
# X5_CONTROL_PORT=5081
# MQTT control and Home Assistant MQTT Discovery.
# X5_MQTT_BROKER=iotlocal.lan
# X5_MQTT_PORT=1883
# X5_MQTT_PREFIX=wificam/x5
# X5_MQTT_DISCOVERY_PREFIX=homeassistant
# X5_MQTT_USERNAME=
# X5_MQTT_PASSWORD=
